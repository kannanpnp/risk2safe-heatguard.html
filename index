/* ================= acclimatization ================= */
function buildAccl(){
  const type = document.getElementById("a_type").value;
  const sv = document.getElementById("a_start").value;
  const start = sv ? new Date(sv+"T00:00:00") : new Date();
  const plan = type==="new" ? [20,40,60,80,100] : [50,60,80,100];
  let rows = "";
  plan.forEach((p,i)=>{
    const d = new Date(start); d.setDate(d.getDate()+i);
    rows += "<tr><td><b>Day " + (i+1) + "</b><br><span class='hint'>" +
      d.toLocaleDateString(undefined,{weekday:"short",day:"numeric",month:"short"}) + "</span></td>" +
      "<td class='mono'>" + p + " %</td>" +
      "<td>" + (p<100 ? "Max " + p + "% of normal heat-exposure duration; lighter duties for the balance; buddy supervision; extra hydration checks." : "Full duties — continue routine monitoring.") + "</td></tr>";
  });
  document.getElementById("a_out").innerHTML =
    "<div class='twrap'><table><thead><tr><th>Day</th><th>Heat exposure</th><th>Controls</th></tr></thead><tbody>" + rows + "</tbody></table></div>" +
    "<div class='alertbox info' style='margin-top:10px'>Record the schedule on the daily heat permit. If the worker misses a day through illness or absence, hold at the previous step; if absent ≥ 1 week, restart as “returning”.</div>";
}

/* ================= first aid tree ================= */
const FA_STEPS = {
  start:{q:"Is the casualty confused, aggressive, staggering, collapsed, fitting, or unresponsive?",
    yes:"stroke", no:"q2"},
  q2:{q:"Do they feel very hot to touch, or has a measured temperature reached 39 °C or above?",
    yes:"stroke", no:"q3"},
  q3:{q:"Are they dizzy, nauseous, headachy, cramping, or sweating heavily with pale clammy skin?",
    yes:"exhaustion", no:"q4"},
  q4:{q:"Painful muscle cramps only, mentally normal, otherwise well?",
    yes:"cramps", no:"minor"}
};
const FA_OUT = {
  stroke:`<div class="fa-outcome emergency"><h3>⚠ Treat as HEAT STROKE — medical emergency</h3>
    <b>Cool first, transport second. Act within minutes.</b>
    <ul><li>Call emergency response / site medic NOW — state "suspected heat stroke".</li>
    <li>Move to shade. Remove outer clothing and boots.</li>
    <li>Drench with water head-to-toe; fan continuously. Ice packs to neck, armpits, groin. Immersion/tarp cooling if available.</li>
    <li>Unresponsive + breathing → recovery position. Not breathing → CPR.</li>
    <li><b>No fluids by mouth</b> if confused or drowsy.</li>
    <li>Continue aggressive cooling until medics take over — do not stop for transport preparation.</li></ul></div>`,
  exhaustion:`<div class="fa-outcome caution"><h3>Heat exhaustion — remove from heat now</h3>
    <ul><li>Stop work. Walk (do not let them walk alone) to a cooled rest area; lie down, legs raised.</li>
    <li>Loosen clothing; cool with wet cloths and fanning.</li>
    <li>Sip cool water / electrolyte drink — about 1 L over the first hour.</li>
    <li>Observe continuously for 30 minutes. <b>Any confusion, vomiting, or no improvement → treat as heat stroke.</b></li>
    <li>No return to heat work same shift. Record as an incident; review controls that let it happen.</li></ul></div>`,
  cramps:`<div class="fa-outcome caution"><h3>Heat cramps</h3>
    <ul><li>Rest in shade; gentle stretching of the affected muscle.</li>
    <li>Electrolyte drink (not plain water alone).</li>
    <li>No return to heavy work until cramps fully resolve and fluids replaced.</li>
    <li>Cramps signal salt depletion — check the crew's electrolyte provision.</li></ul></div>`,
  minor:`<div class="fa-outcome caution"><h3>Monitor — possible early heat strain</h3>
    <ul><li>Rest break in shade with fluids as a precaution.</li>
    <li>Check: heat rash, recent illness, medication, fasting, poor sleep, day-count of acclimatization.</li>
    <li>Brief the buddy and supervisor to keep watch. Reassess in 15 minutes; escalate if any red-flag sign appears.</li></ul></div>`
};
let faPos = "start";
function faRender(){
  const el = document.getElementById("faTree");
  if (FA_OUT[faPos]){ el.innerHTML = FA_OUT[faPos]; return; }
  const s = FA_STEPS[faPos];
  el.innerHTML = `<div class="fa-step"><div class="fa-q">${s.q}</div>
    <div class="fa-btns"><button class="btn bad" style="background:var(--bad)" onclick="faGo('${s.yes}')">YES</button>
    <button class="btn ghost" onclick="faGo('${s.no}')">NO</button></div></div>`;
}
function faGo(next){ faPos = next; faRender(); }
function faReset(){ faPos = "start"; faRender(); }

