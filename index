<footer>Risk2Safe HeatGuard · Screening &amp; awareness tool · Aligned to ISO 7243, ACGIH TLV®, TWL zones, OSHAD-SF and GCC summer working-hour rules · Not a substitute for calibrated instruments, medical advice or site HSE procedures.</footer>
<script>
/* ================= core data ================= */
// ACGIH screening criteria (WBGT-eff °C). Rows: % work in cycle. [light, moderate, heavy, vheavy]; null = not permitted at screening level
const TLV = {
  acc: {
    "75–100%": [31.0, 28.0, 25.0, null],
    "50–75%":  [31.0, 29.0, 27.5, null],
    "25–50%":  [32.0, 30.0, 29.0, 28.0],
    "0–25%":   [32.5, 31.5, 30.5, 30.0]
  },
  unacc: {
    "75–100%": [28.0, 25.0, 22.5, null],
    "50–75%":  [28.5, 26.0, 24.0, null],
    "25–50%":  [29.5, 27.0, 25.5, 24.5],
    "0–25%":   [30.0, 29.0, 28.0, 27.0]
  }
};
const WORK_IDX = {light:0, moderate:1, heavy:2, vheavy:3};
const WORK_LABEL = {light:"Light", moderate:"Moderate", heavy:"Heavy", vheavy:"Very heavy"};
const CYCLES = [
  {key:"75–100%", wr:"Continuous (60 min work)", frac:1.0},
  {key:"50–75%",  wr:"45 min work : 15 min rest", frac:0.75},
  {key:"25–50%",  wr:"30 min work : 30 min rest", frac:0.5},
  {key:"0–25%",   wr:"15 min work : 45 min rest", frac:0.25}
];
const FLAGS = [
  {name:"GREEN",  color:"var(--flag-green)",  max:28,  directive:"Normal work with routine heat controls. Water every 20 min, self-pacing, watch new workers."},
  {name:"YELLOW", color:"var(--flag-yellow)", max:30,  directive:"Heightened alert. Enforce scheduled rest breaks in shade, chilled water at task, buddy system for unacclimatized workers."},
  {name:"ORANGE", color:"var(--flag-orange)", max:32,  directive:"Restricted work. Written work-rest regime mandatory, supervisor at work front, reschedule heavy tasks to cooler hours."},
  {name:"RED",    color:"var(--flag-red)",    max:34,  directive:"Severe. Essential work only under specific TRA. Heavy/very-heavy work suspended. Continuous supervision, cooling stations active."},
  {name:"BLACK",  color:"var(--flag-black)",  max:99,  directive:"STOP WORK. Non-emergency outdoor work suspended. Emergency tasks only with dedicated rescue standby and medical support."}
];
const GCC = {
  AE:{name:"United Arab Emirates", from:[6,15], to:[9,15], h1:12.5, h2:15,   rule:"No work under direct sun / open air 12:30–15:00 (MoHRE)"},
  SA:{name:"Saudi Arabia",         from:[6,15], to:[9,15], h1:12,   h2:15,   rule:"No work under direct sunlight 12:00–15:00 (MHRSD)"},
  QA:{name:"Qatar",                from:[6,1],  to:[9,15], h1:10,   h2:15.5, rule:"No outdoor work 10:00–15:30; stop work anywhere if WBGT > 32.1 °C (MD 17/2021)"},
  KW:{name:"Kuwait",               from:[6,1],  to:[8,31], h1:11,   h2:16,   rule:"No outdoor work 11:00–16:00 (PAM)"},
  BH:{name:"Bahrain",              from:[7,1],  to:[8,31], h1:12,   h2:16,   rule:"No outdoor work 12:00–16:00 (MoL)"},
  OM:{name:"Oman",                 from:[6,1],  to:[8,31], h1:12.5, h2:15.5, rule:"No outdoor work 12:30–15:30 (MoL)"}
};

/* ================= storage (guarded) ================= */
function lsGet(k){ try{ return localStorage.getItem(k);}catch(e){ return null; } }
function lsSet(k,v){ try{ localStorage.setItem(k,v);}catch(e){} }

/* ================= psychrometrics ================= */
function vapourPressure(ta, rh){ // hPa
  return (rh/100) * 6.105 * Math.exp((17.27*ta)/(237.7+ta));
}
// Psychrometric wet bulb — Stull (2011)
function wetBulbStull(ta, rh){
  return ta*Math.atan(0.151977*Math.sqrt(rh+8.313659)) + Math.atan(ta+rh)
       - Math.atan(rh-1.676331) + 0.00391838*Math.pow(rh,1.5)*Math.atan(0.023101*rh)
       - 4.686035;
}
// Estimated WBGT: Stull Twb → natural wet bulb & globe estimates → ISO 7243 formula
function wbgtEstimate(ta, rh, sun, ws){
  const twb = wetBulbStull(ta, rh);
  const wind = Math.max(ws, 0.3);
  const windDamp = 1/(1 + 0.35*wind);
  const radNwb = sun==="full" ? 2.5 : sun==="partial" ? 1.2 : 0.2;   // radiant add to nwb
  const radTg  = sun==="full" ? 16  : sun==="partial" ? 8   : 1;      // solar globe increment, still air
  const tnwb = twb + radNwb*windDamp;
  const tg = ta + radTg*windDamp;
  const w = sun==="shade" ? 0.7*tnwb + 0.3*tg : 0.7*tnwb + 0.2*tg + 0.1*ta;
  return Math.round(w*10)/10;
}
// Indicative TWL screening estimate (anchored to published TWL/WBGT field correlations, Gulf conditions)
function twlEstimate(wbgt, ws, sun){
  let twl = 250 - 18*(wbgt - 26);
  twl += Math.max(-15, Math.min((ws-1)*15, 60));   // wind is the dominant reliever
  if (sun === "shade") twl += 20; else if (sun === "partial") twl += 10;
  return Math.round(Math.max(30, Math.min(350, twl)));
}
function twlZone(twl){
  if (twl >= 220) return {name:"Unrestricted", cls:"ok"};
  if (twl >= 140) return {name:"Acclimatization", cls:"warn"};
  if (twl >= 115) return {name:"Buffer", cls:"warn"};
  return {name:"Withdrawal", cls:"bad"};
}
function flagFor(wbgtEff){
  for (const f of FLAGS) if (wbgtEff < f.max) return f;
  return FLAGS[FLAGS.length-1];
}
// Max permissible work fraction for workload & effective WBGT
function allowedCycle(wbgtEff, work, accl){
  const idx = WORK_IDX[work];
  for (const c of CYCLES){
    const lim = TLV[accl][c.key][idx];
    if (lim !== null && wbgtEff <= lim) return c;
  }
  return null;
}

/* ================= tabs & clock ================= */
document.getElementById("tabbar").addEventListener("click", e=>{
  const b = e.target.closest(".tab"); if(!b) return;
  document.querySelectorAll(".tab").forEach(t=>t.classList.remove("active"));
  document.querySelectorAll(".pane").forEach(p=>p.classList.remove("active"));
  b.classList.add("active");
  document.getElementById("pane-"+b.dataset.pane).classList.add("active");
});
function tickClock(){
  const n = new Date();
  document.getElementById("hdClock").innerHTML =
    n.toLocaleDateString(undefined,{weekday:"short",day:"numeric",month:"short"}) +
    "<br><b>" + n.toLocaleTimeString(undefined,{hour:"2-digit",minute:"2-digit"}) + "</b>";
}
setInterval(tickClock, 30000); tickClock();

/* ================= dashboard ================= */
let DASH = null;
function runDashboard(){
  const ta = +document.getElementById("d_ta").value;
  const rh = +document.getElementById("d_rh").value;
  const ws = +document.getElementById("d_ws").value;
  const sun = document.getElementById("d_sun").value;
  const work = document.getElementById("d_work").value;
  const cav = +document.getElementById("d_cloth").value;
  const accl = document.getElementById("d_accl").value;
  if (!isFinite(ta) || !isFinite(rh) || rh<=0){ alert("Enter valid temperature and humidity."); return; }

  const wbgt = wbgtEstimate(ta, rh, sun, ws);
  const wbgtEff = Math.round((wbgt + cav)*10)/10;
  const twl = twlEstimate(wbgt, ws, sun);
  const zone = twlZone(twl);
  const flag = flagFor(wbgtEff);
  const cyc = allowedCycle(wbgtEff, work, accl);
  DASH = {ta,rh,ws,sun,work,cav,accl,wbgt,wbgtEff,twl,zone,flag,cyc};

  document.getElementById("gWbgt").innerHTML = wbgt.toFixed(1)+"<small> °C</small>";
  document.getElementById("gWbgtEff").innerHTML = wbgtEff.toFixed(1)+"<small> °C</small>";
  document.getElementById("gTwl").innerHTML = twl+"<small> W/m²</small>";
  document.getElementById("gWr").textContent = cyc ? cyc.wr.replace(" work","").replace(" rest","") : "STOP";
  document.getElementById("flagSwatch").style.background = flag.color;
  document.getElementById("flagName").textContent = flag.name + " FLAG";
  document.getElementById("gaugeSub").textContent =
    WORK_LABEL[work] + " work · " + (accl==="acc"?"acclimatized":"UNACCLIMATIZED") + " crew · clothing +" + cav + " °C";

  // needle position: map WBGT-eff 25→36 across 4%→96%
  const pct = Math.max(4, Math.min(96, 4 + (wbgtEff-25)/(36-25)*92));
  document.getElementById("needle").style.left = pct + "%";
  document.getElementById("needleVal").textContent = wbgtEff.toFixed(1) + " °C";

  let dir = "<b>" + flag.name + " flag.</b> " + flag.directive;
  dir += cyc
    ? " Regime for " + WORK_LABEL[work].toLowerCase() + " work: <b>" + cyc.wr + "</b> per hour."
    : " <b>" + WORK_LABEL[work] + " work exceeds screening criteria even at 15:45 — suspend, re-engineer the task, or apply detailed analysis (ISO 7933) with physiological monitoring.</b>";
  if (zone.name === "Withdrawal") dir += " TWL is in the <b>withdrawal zone</b> — emergency tasks only.";
  document.getElementById("gDirective").innerHTML = dir;

  // hydration
  const rate = work==="light" ? "≈ 750 mL/hr (250 mL every 20 min)"
             : work==="moderate" ? "≈ 1 L/hr (250 mL every 15 min)"
             : "up to 1 L/hr (250 mL every 15 min) — do not exceed";
  document.getElementById("hydroOut").innerHTML =
    "<div class='readout' style='font-size:22px;margin-bottom:6px'>" + rate + "</div>" +
    "<ul style='margin-left:18px;font-size:13.5px'>" +
    "<li>Cool water (10–15 °C) + electrolyte supplementation for shifts &gt; 2 hrs sweating</li>" +
    "<li>Daily ceiling ≈ 12 L — over-drinking risks hyponatraemia</li>" +
    "<li>Urine check: pale straw = OK; dark = stop, rehydrate before resuming</li>" +
    "<li>Pre-shift hydration brief; no energy drinks as fluid replacement</li></ul>";
  banStatus();
}

function banStatus(){
  const cc = document.getElementById("d_country").value;
  const r = gccEval(cc, new Date());
  document.getElementById("banOut").innerHTML = r.html;
}
function gccEval(cc, dt){
  const c = GCC[cc];
  const m = dt.getMonth()+1, d = dt.getDate();
  const afterStart = (m > c.from[0]) || (m === c.from[0] && d >= c.from[1]);
  const beforeEnd  = (m < c.to[0])   || (m === c.to[0]   && d <= c.to[1]);
  const inSeason = afterStart && beforeEnd;
  const hr = dt.getHours() + dt.getMinutes()/60;
  const inWindow = hr >= c.h1 && hr < c.h2;
  const fmt = h => String(Math.floor(h)).padStart(2,"0") + ":" + String(Math.round((h%1)*60)).padStart(2,"0");
  let html;
  if (inSeason && inWindow)
    html = "<div class='alertbox bad'><b>BAN ACTIVE NOW — " + c.name + ".</b> " + c.rule + ". Outdoor work in the sun must stop until " + fmt(c.h2) + ".</div>";
  else if (inSeason)
    html = "<div class='alertbox warn'><b>Summer rules in force — " + c.name + ".</b> " + c.rule + ". Ban window today: " + fmt(c.h1) + "–" + fmt(c.h2) + ".</div>";
  else
    html = "<div class='alertbox ok'><b>Outside statutory summer period — " + c.name + ".</b> " + c.rule + " applies " + c.from[1] + "/" + c.from[0] + " to " + c.to[1] + "/" + c.to[0] + ". Heat risk controls still apply whenever conditions demand.</div>";
  return {inSeason, inWindow, html};
}

/* ================= calculators pane ================= */
let LAST_WBGT = null;
function calcWBGTmeasured(){
  const tnwb = +document.getElementById("c_tnwb").value;
  const tg = +document.getElementById("c_tg").value;
  const tdb = +document.getElementById("c_tdb").value;
  const env = document.getElementById("c_env").value;
  const w = env==="out" ? 0.7*tnwb + 0.2*tg + 0.1*tdb : 0.7*tnwb + 0.3*tg;
  LAST_WBGT = Math.round(w*100)/100;
  document.getElementById("c_wbgtOut").innerHTML =
    "<div class='readout'>" + LAST_WBGT.toFixed(2) + "<small> °C WBGT</small></div>" +
    "<div class='hint mono'>" + (env==="out" ? "WBGT = 0.7·Tnwb + 0.2·Tg + 0.1·Ta" : "WBGT = 0.7·Tnwb + 0.3·Tg") + "</div>";
}
function calcTLV(){
  if (LAST_WBGT === null){ calcWBGTmeasured(); }
  const work = document.getElementById("c_work").value;
  const cav = +document.getElementById("c_cloth").value;
  const accl = document.getElementById("c_accl").value;
  const eff = Math.round((LAST_WBGT + cav)*10)/10;
  const cyc = allowedCycle(eff, work, accl);
  const label = accl==="acc" ? "TLV (acclimatized)" : "Action Limit (unacclimatized)";
  let html = "<div class='readout' style='font-size:24px'>WBGT<sub>eff</sub> " + eff.toFixed(1) + "<small> °C</small></div>";
  if (cyc){
    const lim = TLV[accl][cyc.key][WORK_IDX[work]];
    html += "<div class='alertbox " + (cyc.frac===1?"ok":"warn") + "'><b>Permitted:</b> " + cyc.wr + " for " +
      WORK_LABEL[work].toLowerCase() + " work (" + label + " " + lim.toFixed(1) + " °C at " + cyc.key + " work).</div>";
  } else {
    html += "<div class='alertbox bad'><b>Exceeds screening criteria at all work-rest ratios.</b> Suspend the task, reduce metabolic load / add engineering controls, or proceed only under detailed analysis (ISO 7933 PHS) with physiological monitoring.</div>";
  }
  document.getElementById("c_tlvOut").innerHTML = html;
}
function calcTWLpane(){
  const ta=+document.getElementById("t_ta").value, rh=+document.getElementById("t_rh").value,
        ws=+document.getElementById("t_ws").value, sun=document.getElementById("t_sun").value;
  const wbgt = wbgtEstimate(ta,rh,sun,ws);
  const twl = twlEstimate(wbgt,ws,sun);
  const z = twlZone(twl);
  document.getElementById("t_out").innerHTML =
    "<div class='readout'>" + twl + "<small> W/m² TWL</small></div>" +
    "<div class='hint'>Derived from est. WBGT " + wbgt.toFixed(1) + " °C · wind " + ws + " m/s</div>" +
    "<div class='alertbox " + z.cls + "'><b>" + z.name + " zone.</b> Apply the controls in the table below.</div>";
}

/* ================= planner ================= */
function buildTLVtable(){
  const tb = document.getElementById("tlvTable");
  let html = "<tr><td colspan='5' style='background:var(--ink-2);color:#fff;font-weight:600'>TLV — Acclimatized</td></tr>";
  for (const c of CYCLES){
    const r = TLV.acc[c.key];
    html += "<tr><td><b>" + c.key + "</b><br><span class='hint'>" + c.wr + "</span></td>" +
      r.map(v=>"<td class='mono'>"+(v===null?"—":v.toFixed(1))+"</td>").join("") + "</tr>";
  }
  html += "<tr><td colspan='5' style='background:var(--ink-2);color:#fff;font-weight:600'>Action Limit — Unacclimatized</td></tr>";
  for (const c of CYCLES){
    const r = TLV.unacc[c.key];
    html += "<tr><td><b>" + c.key + "</b><br><span class='hint'>" + c.wr + "</span></td>" +
      r.map(v=>"<td class='mono'>"+(v===null?"—":v.toFixed(1))+"</td>").join("") + "</tr>";
  }
  tb.innerHTML = html;
}
function runPlanner(){
  const eff = +document.getElementById("p_wbgt").value;
  const work = document.getElementById("p_work").value;
  const accl = document.getElementById("p_accl").value;
  const cyc = allowedCycle(eff, work, accl);
  const flag = flagFor(eff);
  let html = "<div class='flagchip' style='background:var(--surface);border-color:var(--line);color:var(--txt);display:inline-flex;margin-bottom:12px'>" +
    "<span class='swatch' style='background:" + flag.color + "'></span><span class='fname'>" + flag.name + " FLAG</span></div>";
  if (cyc){
    html += "<div class='alertbox " + (cyc.frac===1?"ok":"warn") + "'><b>Hourly regime: " + cyc.wr + "</b> for " + WORK_LABEL[work].toLowerCase() + " work (" + (accl==="acc"?"acclimatized":"unacclimatized") + ").</div>";
    html += "<ul style='margin-left:18px;font-size:13.5px'>" +
      "<li>Rest = shaded / cooled shelter, seated, with fluids — walking to the shelter counts as work.</li>" +
      "<li>Drink 250 mL each rest break minimum; supervisor verifies intake, not just availability.</li>" +
      "<li>Rotate crews on the regime — do not bank rest to extend work periods.</li>" +
      "<li>Re-assess whenever conditions change ≥ 1 °C WBGT or the task's metabolic load changes.</li></ul>";
  } else {
    html += "<div class='alertbox bad'><b>No compliant work-rest ratio exists at this workload.</b> Options: reschedule to cooler hours, mechanize / reduce metabolic rate, add shade or spot cooling, or apply ISO 7933 detailed analysis with medical monitoring.</div>";
  }
  document.getElementById("p_out").innerHTML = html;
}

