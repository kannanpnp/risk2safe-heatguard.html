<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Risk2Safe HeatGuard — Heat Stress Management Suite</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#16212E; --ink-2:#22303F; --ink-3:#31414F;
  --surface:#F2F3EF; --card:#FFFFFF; --line:#D8DAD3; --line-2:#E8E9E4;
  --amber:#FFB000; --amber-dk:#C78700;
  --txt:#1B2430; --txt-2:#5A6572; --txt-3:#8B939D;
  --flag-white:#F4F4F4; --flag-green:#2E9E5B; --flag-yellow:#F5C518;
  --flag-orange:#E8722A; --flag-red:#D8342C; --flag-black:#141414;
  --ok:#2E9E5B; --warn:#E8722A; --bad:#D8342C;
  --r:10px; --r-sm:6px;
  --disp:'Barlow Condensed',sans-serif; --body:'Inter',sans-serif; --mono:'IBM Plex Mono',monospace;
}
*{box-sizing:border-box;margin:0;padding:0}
html{-webkit-text-size-adjust:100%}
body{font-family:var(--body);background:var(--surface);color:var(--txt);font-size:15px;line-height:1.5;min-height:100vh}
button{font-family:inherit;cursor:pointer}
input,select,textarea{font-family:inherit;font-size:15px}

/* ---------- header ---------- */
header{background:var(--ink);color:#fff;padding:0}
.hd-top{display:flex;align-items:center;gap:14px;padding:14px 18px;max-width:1200px;margin:0 auto}
.hd-mark{width:42px;height:42px;border-radius:8px;background:var(--amber);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.hd-mark svg{width:26px;height:26px}
.hd-title{font-family:var(--disp);font-size:26px;font-weight:700;letter-spacing:.5px;line-height:1.05}
.hd-sub{font-size:11.5px;color:#9FB0C0;letter-spacing:.4px;margin-top:2px}
.hd-clock{margin-left:auto;text-align:right;font-family:var(--mono);font-size:12px;color:#B8C4CF;line-height:1.4}
.hd-clock b{color:var(--amber);font-weight:600}

/* ---------- tabs ---------- */
nav{background:var(--ink-2);overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none}
nav::-webkit-scrollbar{display:none}
.tabs{display:flex;max-width:1200px;margin:0 auto;padding:0 10px}
.tab{background:none;border:none;color:#9FB0C0;font-family:var(--disp);font-size:16px;font-weight:600;letter-spacing:.6px;padding:12px 15px;white-space:nowrap;border-bottom:3px solid transparent;text-transform:uppercase}
.tab:hover{color:#fff}
.tab.active{color:var(--amber);border-bottom-color:var(--amber)}

main{max-width:1200px;margin:0 auto;padding:20px 16px 70px}
.pane{display:none}
.pane.active{display:block;animation:fade .18s ease}
@keyframes fade{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){.pane.active{animation:none}}

/* ---------- generic ---------- */
.grid{display:grid;gap:16px}
.dash-grid{grid-template-columns:340px 1fr;align-items:start}
@media(max-width:920px){.dash-grid{grid-template-columns:1fr}.dash-grid .card{position:static!important}}
.g2{grid-template-columns:1fr 1fr}
.g3{grid-template-columns:repeat(3,1fr)}
@media(max-width:820px){.g2,.g3{grid-template-columns:1fr}}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:18px}
.card h2{font-family:var(--disp);font-size:21px;font-weight:700;letter-spacing:.4px;text-transform:uppercase;margin-bottom:4px}
.card .kicker{font-size:11px;font-weight:600;letter-spacing:1.2px;text-transform:uppercase;color:var(--amber-dk);margin-bottom:2px}
.card .note{font-size:12.5px;color:var(--txt-2);margin-bottom:14px}
.frow{display:flex;flex-direction:column;gap:5px;margin-bottom:12px}
.frow label{font-size:12px;font-weight:600;letter-spacing:.3px;color:var(--txt-2);text-transform:uppercase}
.frow input,.frow select,.frow textarea{padding:10px 12px;border:1px solid var(--line);border-radius:var(--r-sm);background:#fff;width:100%}
.frow input:focus,.frow select:focus,.frow textarea:focus{outline:2px solid var(--amber);outline-offset:1px;border-color:var(--amber)}
.frow .hint{font-size:11.5px;color:var(--txt-3)}
.irow{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:480px){.irow{grid-template-columns:1fr}}
.btn{background:var(--ink);color:#fff;border:none;border-radius:var(--r-sm);padding:12px 20px;font-weight:600;font-size:14px;letter-spacing:.3px}
.btn:hover{background:var(--ink-3)}
.btn.amber{background:var(--amber);color:var(--ink)}
.btn.amber:hover{background:#E5A000}
.btn.ghost{background:transparent;color:var(--ink);border:1.5px solid var(--ink)}
.btn.sm{padding:8px 14px;font-size:13px}
.btn:disabled{opacity:.5;cursor:not-allowed}
.btn:focus-visible{outline:3px solid var(--amber);outline-offset:2px}
.mono{font-family:var(--mono)}
.readout{font-family:var(--mono);font-size:30px;font-weight:600;line-height:1.1}
.readout small{font-size:14px;color:var(--txt-3);font-weight:400}
.tag{display:inline-block;font-size:11px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;padding:3px 9px;border-radius:99px}
table{width:100%;border-collapse:collapse;font-size:13.5px}
th{font-family:var(--disp);font-size:14px;letter-spacing:.6px;text-transform:uppercase;text-align:left;padding:8px 10px;background:var(--ink);color:#fff}
td{padding:8px 10px;border-bottom:1px solid var(--line-2);vertical-align:top}
tr:nth-child(even) td{background:#FAFAF7}
.twrap{overflow-x:auto;border:1px solid var(--line);border-radius:var(--r-sm)}
.divider{height:1px;background:var(--line);margin:16px 0}
.alertbox{border-radius:var(--r-sm);padding:12px 14px;font-size:13.5px;margin:10px 0;border:1px solid}
.alertbox.ok{background:#EDF7F0;border-color:#BCE0C9;color:#1D6B3D}
.alertbox.warn{background:#FDF1E7;border-color:#F3CDAE;color:#9A4A15}
.alertbox.bad{background:#FBEBEA;border-color:#F0BBB8;color:#8F211B}
.alertbox.info{background:#EEF3F8;border-color:#C9D8E6;color:#2C4A66}

/* ---------- signature: heat flag gauge ---------- */
.gauge-card{background:var(--ink);color:#fff;border:none;border-radius:var(--r);padding:22px 20px 26px;position:relative;overflow:hidden}
.gauge-card::after{content:"";position:absolute;inset:0;background:repeating-linear-gradient(-45deg,transparent 0 26px,rgba(255,176,0,.045) 26px 52px);pointer-events:none}
.gauge-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:18px}
.gauge-title{font-family:var(--disp);font-size:22px;font-weight:700;letter-spacing:.8px;text-transform:uppercase}
.gauge-sub{font-size:12px;color:#9FB0C0;margin-top:2px}
.flagchip{display:flex;align-items:center;gap:10px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.15);border-radius:8px;padding:8px 14px}
.flagchip .swatch{width:22px;height:16px;border-radius:3px;border:1px solid rgba(255,255,255,.4);box-shadow:0 0 0 1px rgba(0,0,0,.3)}
.flagchip .fname{font-family:var(--disp);font-size:19px;font-weight:700;letter-spacing:.8px;text-transform:uppercase}
.spectrum{position:relative;height:56px;margin:8px 4px 30px}
.spectrum .band{position:absolute;inset:14px 0;border-radius:6px;background:linear-gradient(90deg,#2E9E5B 0%,#2E9E5B 30%,#F5C518 42%,#E8722A 58%,#D8342C 74%,#141414 92%);box-shadow:inset 0 0 0 1px rgba(255,255,255,.2)}
.spectrum .tick{position:absolute;top:46px;font-family:var(--mono);font-size:10.5px;color:#9FB0C0;transform:translateX(-50%)}
.needle{position:absolute;top:2px;transform:translateX(-50%);transition:left .5s cubic-bezier(.4,0,.2,1);text-align:center}
@media (prefers-reduced-motion:reduce){.needle{transition:none}}
.needle .stem{width:3px;height:40px;background:#fff;margin:0 auto;border-radius:2px;box-shadow:0 0 6px rgba(0,0,0,.6)}
.needle .val{position:absolute;top:-4px;left:50%;transform:translate(-50%,-100%);background:var(--amber);color:var(--ink);font-family:var(--mono);font-size:12px;font-weight:600;padding:2px 7px;border-radius:4px;white-space:nowrap}
.gauge-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;position:relative}
@media(max-width:680px){.gauge-stats{grid-template-columns:1fr 1fr}}
.gstat{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:8px;padding:10px 12px}
.gstat .lbl{font-size:10.5px;letter-spacing:1px;text-transform:uppercase;color:#9FB0C0}
.gstat .v{font-family:var(--mono);font-size:21px;font-weight:600;margin-top:2px}
.gstat .v small{font-size:12px;color:#9FB0C0}
.gauge-directive{margin-top:16px;background:rgba(255,176,0,.12);border:1px solid rgba(255,176,0,.4);border-radius:8px;padding:12px 14px;font-size:13.5px;position:relative}
.gauge-directive b{color:var(--amber)}

/* first aid tree */
.fa-step{border:1.5px solid var(--line);border-radius:var(--r);padding:18px;margin-bottom:12px}
.fa-q{font-family:var(--disp);font-size:20px;font-weight:700;margin-bottom:12px}
.fa-btns{display:flex;gap:10px;flex-wrap:wrap}
.fa-outcome{border-radius:var(--r);padding:18px;font-size:14.5px}
.fa-outcome.emergency{background:#8F211B;color:#fff}
.fa-outcome.emergency h3{font-family:var(--disp);font-size:24px;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px}
.fa-outcome.caution{background:#FDF1E7;border:1.5px solid #E8722A;color:#7A3A10}
.fa-outcome.caution h3{font-family:var(--disp);font-size:22px;text-transform:uppercase;margin-bottom:8px;color:#B04E12}
.fa-outcome ul{margin:8px 0 0 18px}
.fa-outcome li{margin-bottom:5px}

/* AI output */
.ai-out{background:#FBFBF8;border:1px solid var(--line);border-radius:var(--r-sm);padding:16px;font-size:14px;white-space:pre-wrap;line-height:1.65;min-height:60px}
.spinner{display:inline-block;width:16px;height:16px;border:2.5px solid var(--line);border-top-color:var(--amber-dk);border-radius:50%;animation:spin .7s linear infinite;vertical-align:-3px;margin-right:6px}
@keyframes spin{to{transform:rotate(360deg)}}

/* permit print */
.permit-doc{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:26px;margin-top:16px}
.permit-doc h1{font-family:var(--disp);font-size:26px;letter-spacing:.6px;text-transform:uppercase;border-bottom:3px solid var(--ink);padding-bottom:8px;margin-bottom:14px}
.permit-doc .prow{display:flex;justify-content:space-between;gap:14px;border-bottom:1px dotted var(--line);padding:6px 0;font-size:13.5px}
.permit-doc .prow b{min-width:200px}
.permit-doc h3{font-family:var(--disp);font-size:17px;text-transform:uppercase;letter-spacing:.5px;margin:16px 0 8px}
.sigline{display:flex;gap:30px;margin-top:26px}
.sigline div{flex:1;border-top:1.5px solid var(--ink);padding-top:6px;font-size:12px;color:var(--txt-2)}
@media print{
  header,nav,.no-print{display:none!important}
  body{background:#fff}
  main{padding:0;max-width:none}
  .pane{display:none!important}
  #pane-permit{display:block!important}
  #pane-permit .card:not(.permit-print-keep){display:none}
  .permit-doc{border:none;padding:0}
}
footer{text-align:center;font-size:11.5px;color:var(--txt-3);padding:18px;border-top:1px solid var(--line);max-width:1200px;margin:0 auto}
.disclaimer{font-size:11.5px;color:var(--txt-3);margin-top:12px;line-height:1.5}
</style>
</head>
<body>
<header>
  <div class="hd-top">
    <div class="hd-mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none"><path d="M12 2c-2 4-6 6.5-6 11a6 6 0 0 0 12 0c0-4.5-4-7-6-11Z" stroke="#16212E" stroke-width="2" fill="#16212E"/><path d="M12 17.5a2.5 2.5 0 0 1-2.5-2.5c0-1.6 1.4-2.6 2.5-4 1.1 1.4 2.5 2.4 2.5 4a2.5 2.5 0 0 1-2.5 2.5Z" fill="#FFB000"/></svg>
    </div>
    <div>
      <div class="hd-title">RISK2SAFE HEATGUARD</div>
      <div class="hd-sub">Heat Stress Management Suite · ISO 7243 · ACGIH TLV · TWL · GCC Regulations</div>
    </div>
    <div class="hd-clock" id="hdClock"></div>
  </div>
  <nav>
    <div class="tabs" role="tablist" id="tabbar">
      <button class="tab active" data-pane="dash">Dashboard</button>
      <button class="tab" data-pane="calc">WBGT · TWL</button>
      <button class="tab" data-pane="plan">Work-Rest</button>
      <button class="tab" data-pane="gcc">GCC Compliance</button>
      <button class="tab" data-pane="accl">Acclimatization</button>
      <button class="tab" data-pane="aid">First Aid</button>
      <button class="tab" data-pane="ai">AI Tools</button>
      <button class="tab" data-pane="permit">Heat Permit</button>
      <button class="tab" data-pane="set">Settings</button>
    </div>
  </nav>
</header>
<main>

<!-- ================= DASHBOARD ================= -->
<section class="pane active" id="pane-dash">
  <div class="grid dash-grid">
    <div class="card" id="dashInputs" style="position:sticky;top:12px">
      <div class="kicker">Site conditions</div>
      <h2>Current Readings</h2>
      <div class="note">Enter conditions from your weather station or heat stress monitor.</div>
      <div class="irow">
        <div class="frow"><label for="d_ta">Air temp °C</label><input type="number" id="d_ta" value="42" step="0.5" inputmode="decimal"></div>
        <div class="frow"><label for="d_rh">Humidity %RH</label><input type="number" id="d_rh" value="35" step="1" min="1" max="100" inputmode="decimal"></div>
      </div>
      <div class="irow">
        <div class="frow"><label for="d_ws">Wind m/s</label><input type="number" id="d_ws" value="1.5" step="0.5" min="0" inputmode="decimal"></div>
        <div class="frow"><label for="d_sun">Sun exposure</label>
          <select id="d_sun"><option value="full">Full sun</option><option value="partial">Partial shade</option><option value="shade">Full shade / indoor</option></select></div>
      </div>
      <div class="frow"><label for="d_work">Metabolic workload</label>
        <select id="d_work">
          <option value="light">Light — sitting, light hand work (~180 W)</option>
          <option value="moderate" selected>Moderate — walking, moderate lifting (~300 W)</option>
          <option value="heavy">Heavy — shovelling, heavy material handling (~415 W)</option>
          <option value="vheavy">Very heavy — intense pace work (~520 W)</option>
        </select></div>
      <div class="frow"><label for="d_cloth">Clothing</label>
        <select id="d_cloth">
          <option value="0">Work coveralls / shirt &amp; trousers (+0 °C)</option>
          <option value="0.5">SMS polypropylene coveralls (+0.5 °C)</option>
          <option value="1">Polyolefin coveralls (+1 °C)</option>
          <option value="3">Double-layer woven clothing (+3 °C)</option>
          <option value="11">Vapour-barrier / encapsulating (+11 °C)</option>
        </select></div>
      <div class="frow"><label for="d_accl">Workforce acclimatization</label>
        <select id="d_accl"><option value="acc">Acclimatized (&gt;2 weeks in heat)</option><option value="unacc">Not acclimatized / new / returning</option></select></div>
      <button class="btn amber" style="width:100%" onclick="runDashboard()">Assess Heat Risk</button>
    </div>

    <div>
      <div class="gauge-card">
        <div class="gauge-head">
          <div>
            <div class="gauge-title">Site Heat Flag</div>
            <div class="gauge-sub" id="gaugeSub">Enter conditions and assess to raise the flag</div>
          </div>
          <div class="flagchip"><span class="swatch" id="flagSwatch" style="background:#666"></span><span class="fname" id="flagName">— STANDBY —</span></div>
        </div>
        <div class="spectrum">
          <div class="band"></div>
          <div class="needle" id="needle" style="left:4%"><span class="val" id="needleVal">–</span><div class="stem"></div></div>
          <span class="tick" style="left:6%">WBGT 25</span><span class="tick" style="left:33%">28</span><span class="tick" style="left:50%">30</span><span class="tick" style="left:66%">32</span><span class="tick" style="left:82%">34</span><span class="tick" style="left:96%">36+</span>
        </div>
        <div class="gauge-stats">
          <div class="gstat"><div class="lbl">WBGT (est.)</div><div class="v" id="gWbgt">–<small> °C</small></div></div>
          <div class="gstat"><div class="lbl">Effective WBGT</div><div class="v" id="gWbgtEff">–<small> °C</small></div></div>
          <div class="gstat"><div class="lbl">TWL (indicative)</div><div class="v" id="gTwl">–<small> W/m²</small></div></div>
          <div class="gstat"><div class="lbl">Work : Rest</div><div class="v" id="gWr">–</div></div>
        </div>
        <div class="gauge-directive" id="gDirective"><b>Standby.</b> Complete the site conditions panel and press Assess Heat Risk.</div>
      </div>

      <div class="grid g2" style="margin-top:16px">
        <div class="card">
          <div class="kicker">Hydration</div>
          <h2>Fluid Plan</h2>
          <div id="hydroOut" class="note" style="margin-bottom:0">Run an assessment to generate the hydration plan.</div>
        </div>
        <div class="card">
          <div class="kicker">Regulatory</div>
          <h2>Midday Ban Status</h2>
          <div class="frow"><label for="d_country">Country</label>
            <select id="d_country" onchange="banStatus()">
              <option value="AE">United Arab Emirates</option><option value="SA">Saudi Arabia</option>
              <option value="QA">Qatar</option><option value="KW">Kuwait</option>
              <option value="BH">Bahrain</option><option value="OM">Oman</option>
            </select></div>
          <div id="banOut"></div>
        </div>
      </div>
      <div class="disclaimer">Estimated WBGT uses a meteorological approximation (moderate solar load); TWL shown is an indicative screening value. For definitive readings and stop-work decisions, use a calibrated WBGT / TWL heat stress monitor at the work face. This tool supports — never replaces — competent HSE judgement.</div>
    </div>
  </div>
</section>

<!-- ================= CALCULATORS ================= -->
<section class="pane" id="pane-calc">
  <div class="grid g2">
    <div class="card">
      <div class="kicker">ISO 7243 · Measured</div>
      <h2>WBGT Calculator</h2>
      <div class="note">From direct instrument readings (natural wet bulb, globe, dry bulb).</div>
      <div class="irow">
        <div class="frow"><label for="c_tnwb">Natural wet bulb T<sub>nwb</sub> °C</label><input type="number" id="c_tnwb" value="28" step="0.1" inputmode="decimal"></div>
        <div class="frow"><label for="c_tg">Globe T<sub>g</sub> °C</label><input type="number" id="c_tg" value="50" step="0.1" inputmode="decimal"></div>
      </div>
      <div class="irow">
        <div class="frow"><label for="c_tdb">Dry bulb T<sub>a</sub> °C</label><input type="number" id="c_tdb" value="42" step="0.1" inputmode="decimal"></div>
        <div class="frow"><label for="c_env">Environment</label>
          <select id="c_env"><option value="out">Outdoor (solar load)</option><option value="in">Indoor / no solar</option></select></div>
      </div>
      <button class="btn" onclick="calcWBGTmeasured()">Calculate WBGT</button>
      <div id="c_wbgtOut" style="margin-top:14px"></div>
      <div class="divider"></div>
      <div class="kicker">ACGIH TLV Screening</div>
      <div class="irow">
        <div class="frow"><label for="c_work">Workload</label>
          <select id="c_work"><option value="light">Light</option><option value="moderate" selected>Moderate</option><option value="heavy">Heavy</option><option value="vheavy">Very heavy</option></select></div>
        <div class="frow"><label for="c_cloth">Clothing adjustment</label>
          <select id="c_cloth"><option value="0">Coveralls +0</option><option value="0.5">SMS +0.5</option><option value="1">Polyolefin +1</option><option value="3">Double layer +3</option><option value="11">Vapour barrier +11</option></select></div>
      </div>
      <div class="frow"><label for="c_accl">Acclimatization</label>
        <select id="c_accl"><option value="acc">Acclimatized (TLV)</option><option value="unacc">Unacclimatized (Action Limit)</option></select></div>
      <button class="btn" onclick="calcTLV()">Screen Against TLV</button>
      <div id="c_tlvOut" style="margin-top:14px"></div>
    </div>

    <div class="card">
      <div class="kicker">Brake &amp; Bates method · Gulf standard</div>
      <h2>Thermal Work Limit (TWL)</h2>
      <div class="note">Indicative TWL estimate from environmental inputs. TWL is the limiting sustainable metabolic rate (W/m²) — the preferred Gulf index (OSHAD, Aramco, Qatar).</div>
      <div class="irow">
        <div class="frow"><label for="t_ta">Dry bulb °C</label><input type="number" id="t_ta" value="42" step="0.5" inputmode="decimal"></div>
        <div class="frow"><label for="t_rh">Humidity %RH</label><input type="number" id="t_rh" value="35" step="1" inputmode="decimal"></div>
      </div>
      <div class="irow">
        <div class="frow"><label for="t_ws">Wind speed m/s</label><input type="number" id="t_ws" value="1.5" step="0.5" min="0" inputmode="decimal"></div>
        <div class="frow"><label for="t_sun">Radiant load</label>
          <select id="t_sun"><option value="full">Full sun</option><option value="partial">Partial shade</option><option value="shade">Shade / indoor</option></select></div>
      </div>
      <button class="btn" onclick="calcTWLpane()">Estimate TWL</button>
      <div id="t_out" style="margin-top:14px"></div>
      <div class="divider"></div>
      <div class="twrap"><table>
        <thead><tr><th>TWL W/m²</th><th>Zone</th><th>Controls</th></tr></thead>
        <tbody>
