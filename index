function condSummary(){
  if (!DASH) return "Site conditions not yet assessed (assume UAE summer: ~42 °C, 35 %RH, full sun).";
  return `Air temp ${DASH.ta} °C, RH ${DASH.rh} %, wind ${DASH.ws} m/s, ${DASH.sun} exposure. ` +
    `Estimated WBGT ${DASH.wbgt} °C (effective ${DASH.wbgtEff} °C with clothing +${DASH.cav} °C). ` +
    `Indicative TWL ${DASH.twl} W/m² (${DASH.zone.name} zone). Flag: ${DASH.flag.name}. ` +
    `Workload ${WORK_LABEL[DASH.work]}, crew ${DASH.accl === "acc" ? "acclimatized" : "NOT acclimatized"}. ` +
    `Permitted regime: ${DASH.cyc ? DASH.cyc.wr : "work exceeds screening criteria"}.`;
}
async function callAI(prompt, outEl, btnEl){
  const s = aiSettings();
  if (!s.key){
    outEl.innerHTML = "No API key configured. Open <b>Settings</b> and add your key (stored in this browser only).";
    return;
  }
  const model = s.model || (s.provider === "anthropic" ? "claude-sonnet-4-6" : "gpt-4o-mini");
  btnEl.disabled = true;
  outEl.innerHTML = "<span class='spinner'></span>Generating…";
  try{
    let text;
    if (s.provider === "anthropic"){
      const r = await fetch("https://api.anthropic.com/v1/messages", {
        method:"POST",
        headers:{
          "Content-Type":"application/json",
          "x-api-key": s.key,
          "anthropic-version":"2023-06-01",
          "anthropic-dangerous-direct-browser-access":"true"
        },
        body: JSON.stringify({model, max_tokens:1500, messages:[{role:"user", content:prompt}]})
      });
      const d = await r.json();
      if (d.error) throw new Error(d.error.message);
      text = (d.content||[]).filter(b=>b.type==="text").map(b=>b.text).join("\n");
    } else {
      const r = await fetch("https://api.openai.com/v1/chat/completions", {
        method:"POST",
        headers:{"Content-Type":"application/json","Authorization":"Bearer "+s.key},
        body: JSON.stringify({model, messages:[{role:"user", content:prompt}], max_tokens:1500})
      });
      const d = await r.json();
      if (d.error) throw new Error(d.error.message);
      text = d.choices[0].message.content;
    }
    outEl.textContent = text;
  } catch(err){
    outEl.innerHTML = "<span style='color:var(--bad)'>Request failed: " + err.message + "</span><br>Check the key, model name, and network, then retry.";
  } finally {
    btnEl.disabled = false;
  }
}
function genToolbox(){
